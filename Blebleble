SELECT t.sql_sid, t.sql_uid, s.username, s.hostname, t.sql_database,
       t.sql_stmt, t.sql_runtime, t.sql_totaltime, t.sql_finishtime
FROM sysmaster:syssqltrace t
JOIN sysmaster:syssessions s ON s.sid = t.sql_sid
WHERE t.sql_uid = 457
ORDER BY t.sql_totaltime DESC;


SELECT sid, username, uid, hostname, pid, feprogram, connected
FROM sysmaster:syssessions
WHERE uid = 457;
