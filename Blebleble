onstat -g act | awk '/running/{print $1,$3}' | while read T R; do L=$(onstat -u | grep -F "$R"); U=$(echo "$L" | awk '{print $4}'); [ "$U" = "slink" ] || continue; S=$(echo "$L" | awk '{print $3}'); C=$(onstat -g cpu | awk -v t="$T" '$1==t{print $(NF-2)}'); echo "=== sid $S  tid $T  CPU_Time=${C}s (kumulatywnie od startu watku) ==="; onstat -g sql $S | sed -n '/^Sess/,$p'; done
