#!/bin/bash
# Usage: ./sprawdz_redukcje.sh /sciezka/do/backupow

DIR="${1:-.}"

list_archive() {
    local archive="$1"
    # Rozpoznajemy typ po realnej zawartości pliku, nie po rozszerzeniu
    local ftype
    ftype=$(file -b "$archive")

    case "$ftype" in
        *"gzip compressed"*"tar archive"*|*"POSIX tar archive"*)
            # zwykły tar lub tar spakowany gzipem - tar sam wykrywa kompresję
            tar -tvf "$archive" 2>/dev/null
            ;;
        *"gzip compressed data"*)
            # sam gzip (nie tar) - rzadki przypadek, ale na wszelki wypadek
            echo "SKIP: $archive to pojedynczy gzip, nie archiwum tar"
            ;;
        *"Zip archive"*)
            unzip -l "$archive" 2>/dev/null | awk 'NR>3 {print $1, $4}' 
            ;;
        *)
            echo "SKIP: nieznany typ dla $archive ($ftype)" >&2
            ;;
    esac
}

for archive in "$DIR"/*; do
    [ -f "$archive" ] || continue
    base=$(basename "$archive")
    # akceptuj tylko pliki wygladajace jak <rok>-<miesiac>.cokolwiek
    [[ "$base" =~ ^[0-9]{4}-[0-9]{2}\. ]] || continue

    list_archive "$archive" | grep -E 'redukcja_test\.[0-9]+' | \
    while read -r line; do
        # dla tar: linia typu "perms owner/grp size data godzina sciezka"
        # dla unzip -l: linia typu "size sciezka"
        sz=$(echo "$line" | awk '{
            for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) { print $i; exit }
        }')
        nm=$(echo "$line" | awk '{print $NF}')
        if [ -n "$sz" ] && [ "$sz" -le 38 ] 2>/dev/null; then
            echo "PUSTY   ($sz B)  -> $archive :: $nm"
        else
            echo "MA DANE ($sz B)  -> $archive :: $nm"
        fi
    done
done
