#!/bin/bash
# trace_report.sh - analiza sqltrace Informix (format jak w sqltrace.1300)
#
# Uzycie:
#   ./trace_report.sh sqltrace.1300 [katalog_wyjsciowy]
#
# Zmienne opcjonalne (env):
#   SLOW=0.5      prog (s) Run Time, od ktorego statement trafia do slow.tsv
#   LOCKMIN=0.01  prog (s) lock wait do lock.tsv
#   TOPN=50       ile wierszy w rankingach
#   EXTRACT=20    ile najwolniejszych statementow wyciagnac w calosci z pliku
#                 (drugi przebieg po pliku; 0 = pomin)
#   SAVE_ALL=0    1 = zapisz tez all.tsv (wszystkie rekordy, kilka GB)
#   TMPDIR_SORT   katalog tymczasowy dla sort (domyslnie <outdir>/tmp)
#
# Wynik: <outdir>/report.txt + pliki TSV do dalszego grzebania.

set -u
IN=${1:?"Uzycie: $0 plik_trace [katalog_wyjsciowy]"}
OUT=${2:-./report_$(date +%Y%m%d_%H%M%S)}
SLOW=${SLOW:-0.5}
LOCKMIN=${LOCKMIN:-0.01}
TOPN=${TOPN:-50}
EXTRACT=${EXTRACT:-20}
SAVE_ALL=${SAVE_ALL:-0}

[ -r "$IN" ] || { echo "Nie moge czytac: $IN" >&2; exit 1; }
mkdir -p "$OUT" || exit 1
TMP=${TMPDIR_SORT:-$OUT/tmp}
mkdir -p "$TMP"
export LC_ALL=C
TAB=$(printf '\t')

# ---------------------------------------------------------------- parser
cat > "$OUT/parse.awk" <<'AWK'
function flush(   h, pt, k, ek) {
  if (stmt == "") return
  n++; tot += rt; if (rt > mx) mx = rt
  if (ft != "-") { if (first == "") first = ft; last = ft }
  h = (ft == "-") ? "--" : substr(ft, 1, 2)
  hn[h]++; hs[h] += rt; if (rt > hm[h]) hm[h] = rt; hb[h] += br

  pt = proc "|" tbl
  pn[pt]++; ps[pt] += rt; if (rt > pm[pt]) pm[pt] = rt
  pb[pt] += br; pl[pt] += lwt; pd[pt] += ds

  sn[sess]++; ss[sess] += rt; if (rt > sm[sess]) sm[sess] = rt; sb[sess] += br

  if (sqle != 0 || isame != 0) {
    en++
    ek = sqle "\t" isame "\t" pt
    ec[ek]++
    if (!(ek in ex)) ex[ek] = stmt ":" sess
  }
  if (rt >= slow) {
    printf "%.4f\t%d\t%d\t%.6f\t%.4f\t%d\t%s\t%s\t%s\t%s\t%s\n", \
      rt, br, pr, iow, lwt, ds, ft, proc, tbl, stmt, sess > slowf
    k = pt "|" br
    kn[k]++; ks[k] += rt; if (rt > km[k]) km[k] = rt
  }
  if (lwt >= lockmin) {
    printf "%.4f\t%d\t%.4f\t%s\t%s\t%s\t%s\t%s\n", \
      lwt, lw, rt, ft, proc, tbl, stmt, sess > lockf
  }
  if (act >= 1000 && act > est * 100) {
    mn[pt]++; mest[pt] += est; mact[pt] += act
  }
  if (saveall)
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s:%s\n", \
      rt, maxt, iow, lwt, lw, pr, br, sqle, isame, ft, proc, tbl, stmt, sess > allf
}
BEGIN {
  slowf = wd "/slow.tsv"; lockf = wd "/lock.tsv"; allf = wd "/all.tsv"
  printf "" > slowf; printf "" > lockf
}
/^ *Statement #/ {
  flush()
  stmt = $3; sub(":", "", stmt)
  proc = "-"; tbl = "-"; sess = "-"; ft = "-"
  rt = 0; maxt = 0; iow = 0; lwt = 0; lw = 0; pr = 0; br = 0; ds = 0
  est = 0; act = 0; sqle = 0; isame = 0
  next
}
/Procedure Call Stack:/ { getline; gsub(/^ +/, ""); proc = $1; next }
/using table/ { tbl = $0; sub(/.*\[ */, "", tbl); sub(/ *\].*/, "", tbl); next }
/^ *Sess_id/ {
  getline; sess = $1
  for (i = 1; i <= NF; i++)
    if ($i ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/) { ft = $i; rt = $(i + 1) + 0; break }
  next
}
/^ *Read +Read +% Cache/ { getline; pr = $1 + 0; br = $2 + 0; next }
/^ *Requests +Waits/     { getline; lw = $2 + 0; lwt = $3 + 0; ds = $7 + 0; next }
/^ *Executions +Time/    { getline; maxt = $4 + 0; iow = $6 + 0; next }
/^ *Cost +Rows +Rows/    { getline; est = $2 + 0; act = $3 + 0; sqle = $4 + 0; isame = $5 + 0; next }
END {
  flush()
  for (h in hn)
    printf "%s\t%d\t%.4f\t%.4f\t%.4f\t%d\n", h, hn[h], hs[h], hs[h]/hn[h], hm[h], hb[h] > (wd "/agg_hour.tsv")
  for (k in pn)
    printf "%.4f\t%d\t%.5f\t%.4f\t%d\t%.4f\t%d\t%s\n", ps[k], pn[k], ps[k]/pn[k], pm[k], pb[k], pl[k], pd[k], k > (wd "/agg_pt.tsv")
  for (k in sn)
    printf "%.4f\t%d\t%.4f\t%d\t%s\n", ss[k], sn[k], sm[k], sb[k], k > (wd "/agg_sess.tsv")
  for (k in ec)
    printf "%d\t%s\t%s\n", ec[k], k, ex[k] > (wd "/agg_err.tsv")
  for (k in kn)
    printf "%.4f\t%d\t%.4f\t%s\n", ks[k], kn[k], km[k], k > (wd "/agg_pat.tsv")
  for (k in mn)
    printf "%d\t%d\t%d\t%s\n", mn[k], mest[k]/mn[k], mact[k]/mn[k], k > (wd "/agg_misest.tsv")
  printf "%d\t%.4f\t%.4f\t%s\t%s\t%d\n", n, tot, mx, first, last, en > (wd "/summary.tsv")
}
AWK

# ---------------------------------------------------------------- przebieg 1
echo "[1/3] Parsowanie $IN ..." >&2
T0=$(date +%s)
for f in agg_hour agg_pt agg_sess agg_err agg_pat agg_misest summary; do : > "$OUT/$f.tsv"; done

AWKARGS=(-v wd="$OUT" -v slow="$SLOW" -v lockmin="$LOCKMIN" -v saveall="$SAVE_ALL" -f "$OUT/parse.awk")
if command -v pv >/dev/null 2>&1; then
  pv "$IN" | awk "${AWKARGS[@]}" -
  RC=${PIPESTATUS[1]}
else
  awk "${AWKARGS[@]}" "$IN"
  RC=$?
fi
if [ "$RC" -ne 0 ]; then echo "awk zakonczyl sie bledem ($RC)" >&2; exit "$RC"; fi
echo "      gotowe w $(( $(date +%s) - T0 )) s" >&2

# ---------------------------------------------------------------- raport
echo "[2/3] Budowanie raportu ..." >&2
fmt() { if command -v column >/dev/null 2>&1; then column -t -s "$TAB"; else cat; fi; }
srt() { sort -T "$TMP" -t "$TAB" "$@"; }
section() { printf '\n===== %s =====\n' "$1"; }

{
  echo "Raport z: $IN   ($(date '+%Y-%m-%d %H:%M:%S'))"
  echo "Prog slow: ${SLOW}s, prog lock: ${LOCKMIN}s, TOPN: $TOPN"

  section "PODSUMOWANIE"
  { printf 'rekordow\tsuma_run_s\tmax_run_s\tpierwszy_finish\tostatni_finish\tz_bledami\n'
    cat "$OUT/summary.tsv"; } | fmt

  section "ROZKLAD GODZINOWY (wg Finish Time)"
  { printf 'godz\tn\tsuma_s\tsr_s\tmax_s\tbuf_reads\n'
    srt -k1,1 "$OUT/agg_hour.tsv"; } | fmt

  section "TOP $TOPN NAJWOLNIEJSZYCH STATEMENTOW"
  { printf 'run_s\tbuf_read\tpage_read\tio_wait_s\tlock_wait_s\tdisk_sorts\tfinish\tproc\ttabela\tstmt\tsess\n'
    srt -k1,1nr "$OUT/slow.tsv" | head -n "$TOPN"; } | fmt

  section "TOP $TOPN: SUMARYCZNY CZAS wg proc|tabela  (proc '-' = SQL spoza procedur)"
  { printf 'suma_s\tn\tsr_s\tmax_s\tbuf_reads\tlock_s\tdisk_sorts\tproc|tabela\n'
    srt -k1,1nr "$OUT/agg_pt.tsv" | head -n "$TOPN"; } | fmt

  section "TOP $TOPN: SUMA BUFFER READS wg proc|tabela (kandydaci na skany)"
  { printf 'suma_s\tn\tsr_s\tmax_s\tbuf_reads\tlock_s\tdisk_sorts\tproc|tabela\n'
    srt -k5,5nr "$OUT/agg_pt.tsv" | head -n "$TOPN"; } | fmt

  section "POWTARZALNE CIEZKIE ZAPYTANIA (proc|tabela|buf_reads, tylko >= ${SLOW}s)"
  echo "Ten sam buf_reads wielokrotnie = ten sam plan/skan tej samej tabeli."
  { printf 'suma_s\tn\tmax_s\tproc|tabela|buf_reads\n'
    srt -k1,1nr "$OUT/agg_pat.tsv" | head -n "$TOPN"; } | fmt

  section "TOP $TOPN SESJI wg sumarycznego czasu"
  { printf 'suma_s\tn\tmax_s\tbuf_reads\tsess\n'
    srt -k1,1nr "$OUT/agg_sess.tsv" | head -n "$TOPN"; } | fmt

  section "LOCKI: top proc|tabela wg lock wait"
  { printf 'suma_s\tn\tsr_s\tmax_s\tbuf_reads\tlock_s\tdisk_sorts\tproc|tabela\n'
    srt -k6,6nr "$OUT/agg_pt.tsv" | awk -F"$TAB" '$6>0' | head -n 20; } | fmt

  section "LOCKI: top $TOPN pojedynczych zdarzen (lock wait >= ${LOCKMIN}s)"
  { printf 'lock_s\tlock_waits\trun_s\tfinish\tproc\ttabela\tstmt\tsess\n'
    srt -k1,1nr "$OUT/lock.tsv" | head -n "$TOPN"; } | fmt

  section "BLEDY SQL / ISAM"
  { printf 'n\tsql_err\tisam_err\tproc\ttabela_or_proc|tabela\tprzyklad stmt:sess\n'
    srt -k1,1nr "$OUT/agg_err.tsv" | head -n "$TOPN"; } | fmt

  section "DISK SORTS > 0 (za malo pamieci na sortowanie)"
  { printf 'suma_s\tn\tsr_s\tmax_s\tbuf_reads\tlock_s\tdisk_sorts\tproc|tabela\n'
    srt -k7,7nr "$OUT/agg_pt.tsv" | awk -F"$TAB" '$7>0' | head -n 20; } | fmt

  section "ZLE ESTYMATY (actual rows >= 1000 i > 100x estimated) -> UPDATE STATISTICS?"
  { printf 'n\tsr_est\tsr_actual\tproc|tabela\n'
    srt -k1,1nr "$OUT/agg_misest.tsv" | head -n 20; } | fmt
} > "$OUT/report.txt"

cat "$OUT/report.txt"

# ---------------------------------------------------------------- przebieg 2
if [ "$EXTRACT" -gt 0 ] && [ -s "$OUT/slow.tsv" ]; then
  echo >&2
  echo "[3/3] Wyciaganie pelnych rekordow $EXTRACT najwolniejszych statementow ..." >&2
  srt -k1,1nr "$OUT/slow.tsv" | head -n "$EXTRACT" | cut -f10 > "$OUT/want_ids.txt"
  awk 'NR==FNR { w[$1]=1; next }
       /^ *Statement #/ { id=$3; sub(":","",id); keep=(id in w) }
       keep' "$OUT/want_ids.txt" "$IN" > "$OUT/slow_records.txt"
  echo "      zapisano $OUT/slow_records.txt" >&2
fi

echo >&2
echo "Gotowe. Raport: $OUT/report.txt" >&2
echo "Pliki: slow.tsv lock.tsv agg_*.tsv slow_records.txt (all.tsv jesli SAVE_ALL=1)" >&2
